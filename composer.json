{
    "name": "taw/create",
    "description": "TAW installer: `composer create-project taw/create my-theme` asks which TAW theme to start from (taw-theme or taw-gutenberg) and installs it in place",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Marco Del Riego",
            "email": "marck94zac1@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "TAW\\Create\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TAW\\Create\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "sort-packages": true
    },
    "scripts": {
        "post-create-project-cmd": "TAW\\Create\\Installer::postCreateProject",
        "tools": "@composer install --working-dir=tools --no-interaction --no-progress",
        "test": "tools/vendor/bin/phpunit",
        "phpstan": "tools/vendor/bin/phpstan analyse --memory-limit=-1"
    }
}
